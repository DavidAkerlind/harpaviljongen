# Which API the website reads from. Leave unset to use production.
# For local testing, copy this file to .env.local:  cp .env.example .env.local
VITE_API_URL=http://localhost:7000/api

# Page views are only counted on harpaviljongen.com. Set to "on" to also count them
# locally (they go to the API above, shown on the admin's Statistik page).
# VITE_ANALYTICS=on
